---
config:
  look: neo
  layout: elk
  theme: redux-color
---
erDiagram
	direction TB
	USER {
		serial id PK ""  
		string username  ""  
		string email  ""  
		date inscription_date  ""  
		int total_points  ""  
	}

	FOLLOW {
		int follower_id PK,FK ""  
		int followed_id PK,FK ""  
	}

	BUDDIES {
		int buddy_id_one PK,FK ""  
		int budddy_id_two PK,FK ""  
	}

	USER_BADGE {
		serial id PK,FK ""  
		int user_id PK,FK ""  
		date obtained_date  ""  
	}

	INVITATION {
		int inviter_id FK ""  
		int invited_id FK ""  
		int challenge_id FK ""  
		string status  ""  
		bool is_deleted  "DEFAULT: false"  
	}

	CHALLENGE_MEMBERS {
		int user_id FK ""  
		int challenge_id FK ""  
		float progression  ""  
		boolean is_ended  ""  
	}
    
	CHALLENGE {
		serial id PK ""  
		int owner_id FK "NN"  
		string title  ""  
		text description  ""  
		datetime start_datetime  ""  
		datetime end_datetime  ""  
		int type FK ""  
		string objective_type  ""  
		float targeted_value  ""  
		int capacity_max  "null for indiv"  
	}

	SESSION {
		serial id PK ""  
		datetime debut  ""  
		datetime fin  ""  
		float distance  ""  
		float height_difference  ""  
		float average_speed  ""  
		float min_speed  ""  
		float max_speed  ""  
	}


    DISPOSITIVES {
        serial id PK ""
        int user_id FK ""
        string name ""
        string brand ""
        string model ""
    }

    CAPABILITY {
        serial id PK ""
        string name ""
        string unit ""
    }

    DISPOSITIVE_CAPABILITY {
        int dispostive_id FK ""
        int capability_id FK ""
    }

	TAG {
		serial id PK ""  
		string name  "UQ,NN"  
		date obtained_date  ""  
	}

	OBJECTIVE_TYPE {
		serial id PK ""  
		varchar name  "NN"  
		string description  ""  
	}

	SPORT_CATEGORY {
		serial id PK ""  
		string nom  ""  
		int parent_cat_id FK ""  
	}

	HASHTAG {
		serial id PK ""  
		varchar name  "NN"  
		string description  ""  
	}

	LEVEL {
		int user_id FK ""  
		int challenge_creation_level  "DEFAULT 0"  
		int challenge_done_level  "DEFAULT 0"  
		int session_done_level  "DEFAULT 0"  
		int invitation_level  "DEFAULT 0"  
	}

	SPORT_CATEGORY}o--o{SPORT_CATEGORY:"sub_class"
	CHALLENGE_MEMBERS|o--o{CHALLENGE:"has_member"
	USER}o--o|INVITATION:"inviter/invited"
	USER}o--o|CHALLENGE_MEMBERS:"participate_to"
	USER||--o{SESSION:"did"
	USER}o--||CHALLENGE:"created_by"
	USER}o--o{USER_BADGE:"has_won"
	USER}o--|{BUDDIES:"  "
	INVITATION|o--o{CHALLENGE:"invited_to"
	FOLLOW}o--o{USER:"followed/follower"
	SESSION||--o{SPORT_CATEGORY:"of_type"
	CHALLENGE}|--o{SPORT_CATEGORY:"of_type"
	SESSION}o--o{TAG:"represented_by"
	CHALLENGE}o--o{TAG:"represented_by"
	CHALLENGE||--o{OBJECTIVE_TYPE:"  "
	TAG}o--||OBJECTIVE_TYPE:"inherit"
	TAG}o--||SPORT_CATEGORY:"inherit"
	TAG}o--||HASHTAG:"inherit"
	LEVEL}o--||USER:"has"
	SESSION}|--|{DISPOSITIVES:"has"
	DISPOSITIVES}|--|{CAPABILITY:"has"
    DISPOSITIVES ||--o{ DISPOSITIVE_CAPABILITY : "has"
    CAPABILITY ||--o{ DISPOSITIVE_CAPABILITY : "supports"


	style FOLLOW ::::::::::::::::::::::::::::::::::::::::::::::::::::::stroke-width:4px,stroke-dasharray:5
	style BUDDIES ::::::::::::::::::::::stroke-width:4px,stroke-dasharray:5

	style INVITATION ::::::stroke-width:4px,stroke-dasharray:5
	style CHALLENGE_MEMBERS :::::::::::::::::::::::::::::::::::::::::::::::::::::stroke-width:4px,stroke-dasharray:5

	style LEVEL ::::::stroke-width:4px,stroke-dasharray:5

	FOLLOW:::Ash
	BUDDIES:::Ash
	INVITATION:::Ash
	CHALLENGE_MEMBERS:::Ash
	LEVEL:::Ash
